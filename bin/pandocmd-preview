#!/usr/bin/env fish

set -g default_port 8000
set -g pandocmd_owned_server_pid ""
set -g pandocmd_owned_server_pid_file ""

function use_color --argument-names stream
    switch "$stream"
        case stdout
            test -t 1
        case stderr
            test -t 2
        case '*'
            return 1
    end
end

function styled --argument-names stream role
    set -l text $argv[3..-1]
    if test (count $text) -eq 0
        return 0
    end

    if not use_color "$stream"
        printf "%s" $text
        return 0
    end

    switch "$role"
        case status
            set_color --bold green
        case source
            set_color --bold
        case hash
            set_color yellow
        case url
            set_color --underline cyan
        case meta
            set_color --dim white
    end

    printf "%s" $text
    set_color normal
end

function log_status --argument-names label
    set -l padded_label (printf "%12s" "$label")

    begin
        printf "%s " (styled stderr status "$padded_label")
        for part in $argv[2..-1]
            printf "%s" "$part"
        end
        printf "\n"
    end >&2
end

function print_url --argument-names url
    if use_color stdout
        set_color --underline cyan
        printf "%s" "$url"
        set_color normal
        printf "\n"
    else
        printf "%s\n" "$url"
    end
end

function usage
    echo "Usage: pandocmd-preview [OPTIONS] FILE.md"
    echo
    echo "Build and preview one Markdown file with the pandocmd Lua pipeline."
    echo
    echo "Options:"
    echo "  --build-only      Build once and exit"
    echo "  --serve-only      Serve the shared assets directory and exit when stopped"
    echo "  --hash-only       Print the stable path hash for FILE.md and exit"
    echo "  -p, --port PORT   Preview server port (default: $default_port)"
    echo "  -h, --help        Show this help"
end

function fail --argument-names message
    echo "error: $message" >&2
    exit 1
end

function require_command --argument-names command_name hint
    if not command -q "$command_name"
        if test -n "$hint"
            fail "$command_name not found. $hint"
        else
            fail "$command_name not found"
        end
    end
end

function real_path --argument-names path
    python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$path"
end

function stable_hash --argument-names path
    python3 -c 'import hashlib, os, sys; print(hashlib.sha256(os.path.realpath(sys.argv[1]).encode("utf-8")).hexdigest()[:16])' "$path"
end

function port_open --argument-names port
    python3 -c 'import socket, sys
s = socket.socket()
s.settimeout(0.25)
try:
    code = s.connect_ex(("127.0.0.1", int(sys.argv[1])))
finally:
    s.close()
raise SystemExit(0 if code == 0 else 1)' "$port"
end

function server_pid_file --argument-names port
    echo "/tmp/pandocmd-preview-$port.pid"
end

function server_log_file --argument-names port
    echo "/tmp/pandocmd-preview-$port.log"
end

function cleanup_owned_server --argument-names wait_mode
    if test -n "$pandocmd_owned_server_pid"
        kill "$pandocmd_owned_server_pid" 2>/dev/null
        if test "$wait_mode" = "--wait"
            wait "$pandocmd_owned_server_pid" 2>/dev/null
        end
    end

    if test -n "$pandocmd_owned_server_pid_file"; and test -f "$pandocmd_owned_server_pid_file"
        set -l stored_pid (string trim -- (cat "$pandocmd_owned_server_pid_file"))
        if test "$stored_pid" = "$pandocmd_owned_server_pid"
            command rm -f "$pandocmd_owned_server_pid_file"
        end
    end

    set -g pandocmd_owned_server_pid ""
    set -g pandocmd_owned_server_pid_file ""
end

function install_owned_server_traps
    trap "cleanup_owned_server; exit 130" INT
    trap "cleanup_owned_server; exit 143" TERM
    trap "cleanup_owned_server" EXIT
end

function running_server_pid --argument-names port
    set -l pid_file (server_pid_file "$port")
    if test -f "$pid_file"
        set -l pid (string trim -- (cat "$pid_file"))
        if test -n "$pid"; and kill -0 "$pid" 2>/dev/null
            echo "$pid"
            return 0
        end
    end
    return 1
end

function registered_server_process --argument-names pid
    set -l command_line (ps -p "$pid" -o command= 2>/dev/null)
    string match -q "*pandocmd-preview-server.py*" -- "$command_line"
    or string match -q "*http.server*" -- "$command_line"
end

function stop_registered_server --argument-names port pid
    set -l pid_file (server_pid_file "$port")

    if test -n "$pid"; and registered_server_process "$pid"
        kill "$pid" 2>/dev/null
        sleep 0.2
    end

    if test -f "$pid_file"
        set -l stored_pid (string trim -- (cat "$pid_file"))
        if test "$stored_pid" = "$pid"
            command rm -f "$pid_file"
        end
    end
end

function ensure_preview_layout --argument-names home
    set -l preview_dir "$home/assets/preview"

    mkdir -p "$preview_dir"; or fail "could not create $preview_dir"
end

function build_preview --argument-names home source output live_reload_url
    ensure_preview_layout "$home"
    set -l source_dir (dirname "$source")
    env PANDOCMD_ASSETS_DIR="$home/assets" PANDOCMD_PREVIEW_LIVE_RELOAD_URL="$live_reload_url" pandoc "$source" \
        --resource-path "$source_dir:." \
        -f "$home/lua/reader.lua" \
        -L "$home/lua/filter.lua" \
        -t "$home/lua/writer.lua" \
        -o "$output"
end

function live_reload_server_ready --argument-names port
    python3 -c 'import sys, urllib.error, urllib.request
url = "http://127.0.0.1:{}/__pandocmd/live-reload/health".format(sys.argv[1])
try:
    response = urllib.request.urlopen(url, timeout=1)
except (OSError, urllib.error.URLError):
    raise SystemExit(1)
raise SystemExit(0 if response.status == 204 else 1)
' "$port"
end

function notify_live_reload --argument-names port path
    python3 -c 'import json, sys, urllib.error, urllib.request
url = "http://127.0.0.1:{}/__pandocmd/live-reload".format(sys.argv[1])
data = json.dumps({"path": sys.argv[2]}).encode("utf-8")
request = urllib.request.Request(url, data=data, method="POST", headers={"Content-Type": "application/json"})
try:
    response = urllib.request.urlopen(request, timeout=1)
except (OSError, urllib.error.URLError) as error:
    print("live reload notification failed: {}".format(error), file=sys.stderr)
    raise SystemExit(1)
raise SystemExit(0 if response.status == 204 else 1)
' "$port" "$path"
end

function start_asset_server --argument-names home port log_file
    python3 "$home/bin/pandocmd-preview-server.py" "$port" "$home/assets" >"$log_file" 2>&1 &
    echo $last_pid
end

function start_server_background --argument-names home port
    ensure_preview_layout "$home"

    set -l pid (running_server_pid "$port")
    if test -n "$pid"
        if live_reload_server_ready "$port"
            set -l server_url "http://127.0.0.1:$port/"
            log_status Serving "already running at " (styled stderr url "$server_url") " " (styled stderr meta "(pid $pid)")
            return 0
        end

        log_status Serving "restarting stale preview server " (styled stderr meta "(pid $pid)")
        stop_registered_server "$port" "$pid"
    end

    set pid (running_server_pid "$port")
    if test -n "$pid"
        set -l server_url "http://127.0.0.1:$port/"
        log_status Serving "already running at " (styled stderr url "$server_url") " " (styled stderr meta "(pid $pid)")
        return 0
    end

    if port_open "$port"
        fail "port $port is already in use; pass --port PORT"
    end

    set -l pid_file (server_pid_file "$port")
    set -l log_file (server_log_file "$port")

    set -l pid (start_asset_server "$home" "$port" "$log_file")
    echo "$pid" >"$pid_file"
    sleep 0.3

    if not kill -0 "$pid" 2>/dev/null
        fail "server exited; see $log_file"
    end

    if not port_open "$port"
        fail "server did not open port $port; see $log_file"
    end

    set -g pandocmd_owned_server_pid "$pid"
    set -g pandocmd_owned_server_pid_file "$pid_file"

    set -l server_url "http://127.0.0.1:$port/"
    log_status Serving "$home/assets at " (styled stderr url "$server_url") " " (styled stderr meta "(pid $pid, log $log_file)")
end

function serve_foreground --argument-names home port
    ensure_preview_layout "$home"

    set -l existing_pid (running_server_pid "$port")
    if test -n "$existing_pid"
        if live_reload_server_ready "$port"
            set -l server_url "http://127.0.0.1:$port/"
            log_status Serving "already running at " (styled stderr url "$server_url") " " (styled stderr meta "(pid $existing_pid)")
            return 0
        end

        log_status Serving "restarting stale preview server " (styled stderr meta "(pid $existing_pid)")
        stop_registered_server "$port" "$existing_pid"
    end

    set existing_pid (running_server_pid "$port")
    if test -n "$existing_pid"
        set -l server_url "http://127.0.0.1:$port/"
        log_status Serving "already running at " (styled stderr url "$server_url") " " (styled stderr meta "(pid $existing_pid)")
        return 0
    end

    if port_open "$port"
        fail "port $port is already in use; pass --port PORT"
    end

    set -l pid_file (server_pid_file "$port")
    set -l log_file (server_log_file "$port")
    set -l server_url "http://127.0.0.1:$port/"
    log_status Serving "$home/assets at " (styled stderr url "$server_url")
    set -l pid (start_asset_server "$home" "$port" "$log_file")
    echo "$pid" >"$pid_file"
    trap "command rm -f $pid_file; kill $pid 2>/dev/null; exit 130" INT
    trap "command rm -f $pid_file; kill $pid 2>/dev/null; exit 143" TERM
    trap "command rm -f $pid_file" EXIT
    wait "$pid"
    set -l server_status $status

    if test -f "$pid_file"
        set -l stored_pid (string trim -- (cat "$pid_file"))
        if test "$stored_pid" = "$pid"
            command rm -f "$pid_file"
        end
    end
    trap - INT TERM EXIT

    return "$server_status"
end

function print_watch_files --argument-names home source
    printf "%s\n" "$source"

    for file in "$home"/lua/*.lua "$home"/assets/templates/*.html "$home"/assets/css/*.css "$home"/assets/math-macros.tex "$home"/assets/bib_style.csl
        if test -f "$file"
            printf "%s\n" "$file"
        end
    end
end

function watch_preview --argument-names home source script_path port url
    set -l status_parts (styled stderr source (basename "$source"))
    if test -n "$url"
        set -a status_parts " " (styled stderr url "$url")
    end

    log_status Watching $status_parts
    print_watch_files "$home" "$source" | entr -np "$script_path" --build-only --no-url --notify-reload --port "$port" "$source"
end

argparse h/help build-only serve-only hash-only no-url notify-reload 'p/port=' -- $argv
or begin
    usage >&2
    exit 2
end

if set -q _flag_help
    usage
    exit 0
end

require_command python3 "Install it with Homebrew: brew install python"

set -l port "$default_port"
if set -q _flag_port
    set port $_flag_port[-1]
end

if not string match -qr '^[0-9]+$' -- "$port"
    fail "port must be a number"
end
if test "$port" -lt 1; or test "$port" -gt 65535
    fail "port must be between 1 and 65535"
end

set -l script_path (real_path (status --current-filename))
set -l script_dir (dirname "$script_path")
set -l pandocmd_home (dirname "$script_dir")

if not test -f "$pandocmd_home/lua/reader.lua"; or not test -f "$pandocmd_home/lua/filter.lua"; or not test -f "$pandocmd_home/lua/writer.lua"
    fail "could not locate pandocmd Lua files relative to $script_path"
end
if not test -d "$pandocmd_home/assets"
    fail "could not locate assets relative to $script_path"
end

if set -q _flag_serve_only
    if test (count $argv) -ne 0
        fail "--serve-only does not accept a Markdown file"
    end
    serve_foreground "$pandocmd_home" "$port"
    exit $status
end

if test (count $argv) -ne 1
    usage >&2
    exit 2
end

set -l source (real_path "$argv[1]")
if not test -f "$source"
    fail "source file does not exist: $source"
end

set -l hash (stable_hash "$source")
set -l output "$pandocmd_home/assets/preview/$hash.html"
set -l url "http://127.0.0.1:$port/preview/$hash.html"
set -l live_reload_url "/livereload"

if set -q _flag_hash_only
    echo "$hash"
    exit 0
end

require_command pandoc "Install it with Homebrew: brew install pandoc"
if not set -q _flag_build_only
    require_command entr "Install it with Homebrew: brew install entr"
end

build_preview "$pandocmd_home" "$source" "$output" "$live_reload_url"
or exit $status

log_status Built (styled stderr source (basename "$source")) " -> " (styled stderr hash "$hash")
if set -q _flag_notify_reload
    notify_live_reload "$port" "/preview/$hash.html"
    or log_status Reload "notification failed"
end
if not set -q _flag_no_url; and set -q _flag_build_only
    print_url "$url"
end

if set -q _flag_build_only
    exit 0
end

start_server_background "$pandocmd_home" "$port"
install_owned_server_traps
set -l watch_url ""
if not set -q _flag_no_url
    set watch_url "$url"
end
watch_preview "$pandocmd_home" "$source" "$script_path" "$port" "$watch_url"
set -l watch_status $status
cleanup_owned_server --wait
trap - INT TERM EXIT
exit "$watch_status"
