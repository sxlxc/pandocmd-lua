#!/usr/bin/env fish

# Static preview files are served by the local nginx on port 80 (document root
# is the repo's assets/ directory, via the /opt/homebrew/var/www/pandocmd
# symlink). Live reload is a single persistent hub daemon on 127.0.0.1:35729
# that nginx proxies at /livereload. The hub outlives every `ppl` invocation, so
# the WebSocket URL (ws://127.0.0.1/livereload) is stable and open browser tabs
# keep reloading across repeated runs.

set -g default_public_port 80
set -g hub_port 35729

function use_color --argument-names stream
    switch "$stream"
        case stdout
            test -t 1
        case stderr
            test -t 2
        case '*'
            return 1
    end
end

function styled --argument-names stream role
    set -l text $argv[3..-1]
    if test (count $text) -eq 0
        return 0
    end

    if not use_color "$stream"
        printf "%s" $text
        return 0
    end

    switch "$role"
        case status
            set_color --bold green
        case source
            set_color --bold
        case hash
            set_color yellow
        case url
            set_color --underline cyan
        case meta
            set_color --dim white
        case warn
            set_color --bold yellow
    end

    printf "%s" $text
    set_color normal
end

function log_status --argument-names label
    set -l padded_label (printf "%12s" "$label")

    begin
        printf "%s " (styled stderr status "$padded_label")
        for part in $argv[2..-1]
            printf "%s" "$part"
        end
        printf "\n"
    end >&2
end

function print_url --argument-names url
    if use_color stdout
        set_color --underline cyan
        printf "%s" "$url"
        set_color normal
        printf "\n"
    else
        printf "%s\n" "$url"
    end
end

function usage
    echo "Usage: pandocmd-preview [OPTIONS] FILE.md"
    echo
    echo "Build and preview one Markdown file with the pandocmd Lua pipeline."
    echo "Static files are served by the local nginx on port 80; live reload uses a"
    echo "persistent hub daemon on 127.0.0.1:$hub_port that nginx proxies at /livereload."
    echo
    echo "Options:"
    echo "  --build-only      Build once and exit"
    echo "  --hash-only       Print the stable path hash for FILE.md and exit"
    echo "  --stop            Stop the live-reload hub daemon and exit"
    echo "  -p, --port PORT   Public nginx port for the printed URL (default: $default_public_port)"
    echo "  -h, --help        Show this help"
end

function fail --argument-names message
    echo "error: $message" >&2
    exit 1
end

function require_command --argument-names command_name hint
    if not command -q "$command_name"
        if test -n "$hint"
            fail "$command_name not found. $hint"
        else
            fail "$command_name not found"
        end
    end
end

function real_path --argument-names path
    path resolve -- "$path"
end

function stable_hash --argument-names path
    printf %s (path resolve -- "$path") | shasum -a 256 | string sub -l 16
end

function preview_url --argument-names port hash
    if test "$port" = "80"
        echo "http://127.0.0.1/preview/$hash.html"
    else
        echo "http://127.0.0.1:$port/preview/$hash.html"
    end
end

# ---------------------------------------------------------------------------
# Live-reload hub (persistent daemon, shared across invocations)
# ---------------------------------------------------------------------------

function hub_pid_file --argument-names port
    echo "/tmp/pandocmd-livereload-$port.pid"
end

function hub_log_file --argument-names port
    echo "/tmp/pandocmd-livereload-$port.log"
end

function hub_ready --argument-names port
    curl -fs --max-time 1 -o /dev/null "http://127.0.0.1:$port/__pandocmd/live-reload/health"
end

function hub_pid --argument-names port
    set -l pid_file (hub_pid_file "$port")
    if test -f "$pid_file"
        set -l pid (string trim -- (cat "$pid_file"))
        if test -n "$pid"; and kill -0 "$pid" 2>/dev/null
            echo "$pid"
            return 0
        end
    end
    return 1
end

function ensure_hub --argument-names home port
    if hub_ready "$port"
        set -l pid (hub_pid "$port")
        log_status LiveReload "hub ready at " (styled stderr url "ws://127.0.0.1/livereload") " " (styled stderr meta "(pid $pid, port $port)")
        return 0
    end

    set -l pid_file (hub_pid_file "$port")
    set -l log_file (hub_log_file "$port")

    if not python3 "$home/bin/pandocmd-preview-server.py" --daemon --pid-file "$pid_file" --log-file "$log_file" "$port" "$home/assets"
        fail "could not start live-reload hub on port $port; see $log_file"
    end

    for attempt in (seq 40)
        if hub_ready "$port"
            set -l pid (hub_pid "$port")
            log_status LiveReload "hub started at " (styled stderr url "ws://127.0.0.1/livereload") " " (styled stderr meta "(pid $pid, log $log_file)")
            return 0
        end
        sleep 0.05
    end

    fail "live-reload hub did not become ready on port $port; see $log_file"
end

function stop_hub --argument-names port
    set -l pid (hub_pid "$port")
    if test -z "$pid"
        log_status LiveReload "no hub running on port $port"
        command rm -f (hub_pid_file "$port")
        return 0
    end

    kill "$pid" 2>/dev/null
    for attempt in (seq 20)
        if not kill -0 "$pid" 2>/dev/null
            break
        end
        sleep 0.05
    end
    command rm -f (hub_pid_file "$port")
    log_status LiveReload "stopped hub " (styled stderr meta "(pid $pid)")
end

function notify_live_reload --argument-names port path
    curl -fsS --max-time 1 \
        -H 'Content-Type: application/json' \
        --data "{\"path\":\"$path\"}" \
        "http://127.0.0.1:$port/__pandocmd/live-reload"
end

# ---------------------------------------------------------------------------
# Build + watch
# ---------------------------------------------------------------------------

function ensure_preview_layout --argument-names home
    set -l preview_dir "$home/assets/preview"
    mkdir -p "$preview_dir"; or fail "could not create $preview_dir"
end

function build_preview --argument-names home source output live_reload_url
    ensure_preview_layout "$home"
    set -l source_dir (dirname "$source")
    env PANDOCMD_ASSETS_DIR="$home/assets" PANDOCMD_PREVIEW_LIVE_RELOAD_URL="$live_reload_url" pandoc "$source" \
        --resource-path "$source_dir:." \
        -f "$home/lua/reader.lua" \
        -L "$home/lua/filter.lua" \
        -t "$home/lua/writer.lua" \
        -o "$output"
end

function warn_if_nginx_missing --argument-names url
    set -l code (curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$url")
    if test "$code" != 200
        log_status Warning (styled stderr warn "nginx did not serve ") (styled stderr url "$url") (styled stderr warn " (HTTP $code)")
        log_status "" (styled stderr meta "start it with: brew services start nginx")
    end
end

function print_watch_files --argument-names home source
    printf "%s\n" "$source"

    for file in "$home"/lua/*.lua "$home"/assets/templates/*.html "$home"/assets/css/*.css "$home"/assets/math-macros.tex "$home"/assets/bib_style.csl
        if test -f "$file"
            printf "%s\n" "$file"
        end
    end
end

function watch_preview --argument-names home source script_path port url
    set -l status_parts (styled stderr source (basename "$source"))
    if test -n "$url"
        set -a status_parts " " (styled stderr url "$url")
    end

    log_status Watching $status_parts
    print_watch_files "$home" "$source" | entr -np "$script_path" --build-only --no-url --notify-reload --port "$port" "$source"
end

# ---------------------------------------------------------------------------
# Argument handling
# ---------------------------------------------------------------------------

argparse h/help build-only hash-only stop no-url notify-reload 'p/port=' -- $argv
or begin
    usage >&2
    exit 2
end

if set -q _flag_help
    usage
    exit 0
end

set -l port "$default_public_port"
if set -q _flag_port
    set port $_flag_port[-1]
end

if not string match -qr '^[0-9]+$' -- "$port"
    fail "port must be a number"
end
if test "$port" -lt 1; or test "$port" -gt 65535
    fail "port must be between 1 and 65535"
end

set -l script_path (real_path (status --current-filename))
set -l script_dir (dirname "$script_path")
set -l pandocmd_home (dirname "$script_dir")

if not test -f "$pandocmd_home/lua/reader.lua"; or not test -f "$pandocmd_home/lua/filter.lua"; or not test -f "$pandocmd_home/lua/writer.lua"
    fail "could not locate pandocmd Lua files relative to $script_path"
end
if not test -d "$pandocmd_home/assets"
    fail "could not locate assets relative to $script_path"
end

if set -q _flag_stop
    stop_hub "$hub_port"
    exit 0
end

if test (count $argv) -ne 1
    usage >&2
    exit 2
end

set -l source (real_path "$argv[1]")
if not test -f "$source"
    fail "source file does not exist: $source"
end

set -l hash (stable_hash "$source")
set -l output "$pandocmd_home/assets/preview/$hash.html"
set -l url (preview_url "$port" "$hash")
set -l live_reload_url "/livereload"

if set -q _flag_hash_only
    echo "$hash"
    exit 0
end

require_command pandoc "Install it with Homebrew: brew install pandoc"
if not set -q _flag_build_only
    require_command entr "Install it with Homebrew: brew install entr"
    require_command python3 "Install it with Homebrew: brew install python"
end

build_preview "$pandocmd_home" "$source" "$output" "$live_reload_url"
or exit $status

# Watch rebuilds (--notify-reload) stay quiet on success; the browser reload
# is the feedback. The no-browser warning prints once per disconnected spell.
if not set -q _flag_notify_reload
    log_status Built (styled stderr source (basename "$source")) " -> " (styled stderr hash "$hash")
else
    set -l no_clients_marker "/tmp/pandocmd-livereload-$hub_port.noclients"
    set -l reload_response (notify_live_reload "$hub_port" "/preview/$hash.html")
    if test $status -ne 0
        log_status Reload "notification failed (hub down?); run: $script_path $source"
    else
        set -l client_count (string match -r '"clients":\s*([0-9]+)' -- "$reload_response")[2]
        if test "$client_count" = "0"
            if not test -f "$no_clients_marker"
                touch "$no_clients_marker"
                log_status Reload "no browser connected; open " (styled stderr url "$url")
            end
        else if test -n "$client_count"
            command rm -f "$no_clients_marker"
        end
    end
end
if not set -q _flag_no_url; and set -q _flag_build_only
    print_url "$url"
end

if set -q _flag_build_only
    exit 0
end

ensure_hub "$pandocmd_home" "$hub_port"
warn_if_nginx_missing "$url"
command rm -f "/tmp/pandocmd-livereload-$hub_port.noclients"
set -l watch_url ""
if not set -q _flag_no_url
    set watch_url "$url"
end
watch_preview "$pandocmd_home" "$source" "$script_path" "$port" "$watch_url"
exit $status
