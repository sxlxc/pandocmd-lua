#!/usr/bin/env python3
"""Build and watch pandocmd previews using only the Python standard library."""

import argparse
import base64
import contextlib
import dataclasses
import fcntl
import hashlib
import http.server
import json
import os
from pathlib import Path
import select
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty
import unicodedata
import urllib.error
import urllib.parse
import urllib.request


DEFAULT_PUBLIC_PORT = 80
HUB_PORT = 35729
PREVIEW_URL_PREFIX = "/pandocmd-preview"
ASSET_BASE_URL = PREVIEW_URL_PREFIX + "/assets"
LIVE_RELOAD_PATH = PREVIEW_URL_PREFIX + "/livereload"
LIVE_RELOAD_PROTOCOL = "http://livereload.com/protocols/official-7"
WEBSOCKET_MAGIC = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
SERVICE_NAME = "pandocmd-preview-livereload"
MAX_SLUG_BYTES = 180
POLL_INTERVAL = 0.20
DEBOUNCE_SECONDS = 0.20
NO_PROXY_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
RUNTIME_LUA_FILES = (
    "algorithms.lua",
    "equations.lua",
    "filter.lua",
    "math-punctuation.lua",
    "media.lua",
    "page-meta.lua",
    "pangu.lua",
    "reader.lua",
    "references.lua",
    "sidenotes.lua",
    "source-line-preprocess.lua",
    "source-lines.lua",
    "theorems.lua",
    "util.lua",
    "writer.lua",
)


class PreviewError(Exception):
    """An expected command-line failure with a user-facing message."""


def _urlopen(request, timeout):
    """Open loopback URLs without inheriting user proxy environment variables."""
    return NO_PROXY_OPENER.open(request, timeout=timeout)


@dataclasses.dataclass(frozen=True)
class RuntimePaths:
    root: Path
    assets: Path
    executable: Path
    html: Path
    lua: Path
    nginx_example: Path
    state: Path
    diagnostics: Path
    pid_file: Path
    log_file: Path
    tmp: Path


@dataclasses.dataclass
class BuildResult:
    succeeded: bool
    returncode: int
    diagnostics: str
    dependencies: set


def runtime_paths(root=None):
    if root is None:
        configured = os.environ.get("PANDOCMD_PREVIEW_HOME")
        root = Path(configured) if configured else Path(__file__).resolve().parent.parent
    root = Path(root).expanduser().resolve()
    state = root / "state"
    return RuntimePaths(
        root=root,
        assets=root / "assets",
        executable=root / "bin" / "pandocmd-preview",
        html=root / "html",
        lua=root / "lua",
        nginx_example=root / "nginx" / "pandocmd.conf.example",
        state=state,
        diagnostics=state / "diagnostics",
        pid_file=state / "server.pid",
        log_file=state / "server.log",
        tmp=state / "tmp",
    )


def ensure_runtime_state(paths):
    for directory in (paths.html, paths.html / "media", paths.state, paths.diagnostics, paths.tmp):
        directory.mkdir(parents=True, exist_ok=True)


def runtime_problems(paths):
    required_files = [
        paths.executable,
        paths.assets / "templates" / "default.html",
        paths.assets / "css" / "default.css",
        paths.assets / "math-macros.tex",
        paths.assets / "bib_style.csl",
        paths.nginx_example,
    ]
    required_files.extend(paths.lua / name for name in RUNTIME_LUA_FILES)
    problems = []
    for path in required_files:
        if not path.is_file():
            problems.append("missing runtime file: {}".format(path))
    for path in (paths.assets, paths.lua):
        if not path.is_dir():
            problems.append("missing runtime directory: {}".format(path))
    return problems


def canonical_path(path):
    return os.path.realpath(os.path.abspath(os.path.expanduser(os.fspath(path))))


def canonical_hash(path):
    return hashlib.sha256(canonical_path(path).encode("utf-8")).hexdigest()


def compatibility_hash(path):
    return canonical_hash(path)[:16]


def normalize_slug_text(value):
    value = unicodedata.normalize("NFKC", value)
    output = []
    separator_pending = False
    for character in value:
        category = unicodedata.category(character)
        if category[0] in ("L", "M", "N") or character == "_":
            if separator_pending and output and output[-1] != "-":
                output.append("-")
            output.append(character)
            separator_pending = False
        elif character == "-":
            separator_pending = bool(output)
        else:
            separator_pending = bool(output)
    return "".join(output).strip("-") or "preview"


def _truncate_utf8(value, byte_limit):
    encoded = value.encode("utf-8")
    if len(encoded) <= byte_limit:
        return value
    encoded = encoded[:byte_limit]
    while encoded:
        try:
            return encoded.decode("utf-8").rstrip("-")
        except UnicodeDecodeError:
            encoded = encoded[:-1]
    return ""


def fit_slug(base, source, suffix=""):
    candidate = base + suffix
    if len(candidate.encode("utf-8")) <= MAX_SLUG_BYTES:
        return candidate
    stable_suffix = "-" + canonical_hash(source)[:12]
    prefix = _truncate_utf8(base, MAX_SLUG_BYTES - len(stable_suffix))
    return (prefix or "preview") + stable_suffix


def clean_slug_for_source(source, home=None):
    source = Path(canonical_path(source))
    home = Path(canonical_path(home or Path.home()))
    try:
        relative = source.relative_to(home)
    except ValueError:
        basename = normalize_slug_text(source.stem)
        return fit_slug(basename, source, "-" + canonical_hash(source)[:8])

    without_extension = relative.with_suffix("")
    joined = "-".join(without_extension.parts)
    return fit_slug(normalize_slug_text(joined), source)


def _mapping_file(state_dir):
    return Path(state_dir) / "previews.json"


def _safe_stored_slug(slug):
    if not isinstance(slug, str) or not slug or len(slug.encode("utf-8")) > MAX_SLUG_BYTES:
        return False
    if slug in (".", "..") or slug.startswith("."):
        return False
    return all(
        character in "-_" or unicodedata.category(character)[0] in ("L", "M", "N")
        for character in slug
    )


def _slug_key(slug):
    # Default macOS filesystems are case-insensitive even though URLs are not.
    return unicodedata.normalize("NFKC", slug).casefold()


def _valid_mapping(data):
    if not isinstance(data, dict) or data.get("version") != 1:
        return None
    sources = data.get("sources")
    if not isinstance(sources, dict):
        return None
    clean = {}
    for source, slug in sources.items():
        if not isinstance(source, str) or not os.path.isabs(source):
            continue
        if not _safe_stored_slug(slug):
            continue
        clean[canonical_path(source)] = slug
    return clean


def _quarantine_corrupt_mapping(mapping_path):
    suffix = "{}.{}".format(int(time.time() * 1000), os.getpid())
    corrupt = mapping_path.with_name(mapping_path.name + ".corrupt-" + suffix)
    try:
        os.replace(mapping_path, corrupt)
    except FileNotFoundError:
        pass


def _load_mapping(mapping_path):
    try:
        with mapping_path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, UnicodeError, json.JSONDecodeError):
        _quarantine_corrupt_mapping(mapping_path)
        return {}
    mapping = _valid_mapping(data)
    if mapping is None:
        _quarantine_corrupt_mapping(mapping_path)
        return {}
    return mapping


def _atomic_json_write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary_name)


def allocate_preview_slug(source, state_dir, home=None):
    source = canonical_path(source)
    state_dir = Path(state_dir)
    state_dir.mkdir(parents=True, exist_ok=True)
    lock_path = state_dir / "previews.json.lock"
    mapping_path = _mapping_file(state_dir)
    with lock_path.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        mapping = _load_mapping(mapping_path)
        existing = mapping.get(source)
        if existing and all(
            other == source or _slug_key(slug) != _slug_key(existing)
            for other, slug in mapping.items()
        ):
            return existing

        base = clean_slug_for_source(source, home=home)
        owners = {_slug_key(slug): owner for owner, slug in mapping.items() if owner != source}
        candidate = base
        if _slug_key(candidate) in owners:
            digest = canonical_hash(source)
            for length in range(5, len(digest) + 1):
                candidate = fit_slug(base, source, "-" + digest[:length])
                if _slug_key(candidate) not in owners:
                    break
            else:
                raise PreviewError("could not allocate a unique preview name")

        mapping[source] = candidate
        _atomic_json_write(mapping_path, {"version": 1, "sources": mapping})
        return candidate


def validate_port(value):
    try:
        port = int(value, 10)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError("port must be a number")
    if port < 1 or port > 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def preview_url(slug, port=DEFAULT_PUBLIC_PORT):
    authority = "127.0.0.1" if port == 80 else "127.0.0.1:{}".format(port)
    encoded_slug = urllib.parse.quote(slug, safe="-_.~")
    return "http://{}{}{}/{}.html".format(authority, "", PREVIEW_URL_PREFIX, encoded_slug)


def _atomic_text_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", errors="replace") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary_name)


def _read_dependencies(path):
    dependencies = set()
    try:
        with path.open("r", encoding="utf-8") as handle:
            for line in handle:
                dependency = line.rstrip("\n")
                if dependency:
                    dependencies.add(canonical_path(dependency))
    except (FileNotFoundError, OSError, UnicodeError):
        pass
    return dependencies


def _publish_build(paths, slug, staged_html, staged_media):
    media_parent = paths.html / "media"
    media_parent.mkdir(parents=True, exist_ok=True)
    token = "{}.{}.{}".format(slug, os.getpid(), time.time_ns())
    incoming_media = media_parent / ("." + token + ".new")
    previous_media = media_parent / ("." + token + ".old")
    target_media = media_parent / slug
    target_html = paths.html / (slug + ".html")
    incoming_html = paths.html / ("." + token + ".html")
    had_previous_media = False
    installed_new_media = False

    try:
        os.replace(staged_media, incoming_media)
        os.replace(staged_html, incoming_html)
        if target_media.exists() or target_media.is_symlink():
            os.replace(target_media, previous_media)
            had_previous_media = True
        try:
            os.replace(incoming_media, target_media)
            installed_new_media = True
            os.replace(incoming_html, target_html)
        except BaseException:
            if installed_new_media and (target_media.exists() or target_media.is_symlink()):
                if target_media.is_dir() and not target_media.is_symlink():
                    shutil.rmtree(target_media)
                else:
                    target_media.unlink()
            if had_previous_media:
                os.replace(previous_media, target_media)
                had_previous_media = False
            raise
    finally:
        for leftover in (incoming_media, incoming_html):
            if leftover.is_dir() and not leftover.is_symlink():
                shutil.rmtree(leftover, ignore_errors=True)
            else:
                with contextlib.suppress(OSError):
                    leftover.unlink()

    if had_previous_media:
        if previous_media.is_dir() and not previous_media.is_symlink():
            shutil.rmtree(previous_media, ignore_errors=True)
        else:
            with contextlib.suppress(OSError):
                previous_media.unlink()


def build_preview(paths, source, slug):
    if not _safe_stored_slug(slug):
        raise PreviewError("invalid preview name: {}".format(slug))
    ensure_runtime_state(paths)
    stage = Path(tempfile.mkdtemp(prefix=slug + "-", dir=paths.tmp))
    staged_html = stage / (slug + ".html")
    staged_media = stage / "media" / slug
    manifest = stage / "dependencies.txt"
    staged_media.mkdir(parents=True)
    diagnostics_path = paths.diagnostics / (slug + ".log")
    source = canonical_path(source)

    environment = os.environ.copy()
    environment.update({
        "PANDOCMD_ASSETS_DIR": os.fspath(paths.assets),
        "PANDOCMD_ASSET_BASE_URL": ASSET_BASE_URL,
        "PANDOCMD_PREVIEW_LIVE_RELOAD_URL": LIVE_RELOAD_PATH,
        "PANDOCMD_MEDIA_DIR": os.fspath(staged_media),
        "PANDOCMD_MEDIA_URL_PREFIX": "media/" + slug,
        "PANDOCMD_MEDIA_MANIFEST": os.fspath(manifest),
        "PANDOCMD_RESOURCE_PATH": os.pathsep.join((os.path.dirname(source), os.getcwd())),
    })
    command = [
        "pandoc",
        source,
        "--resource-path", os.pathsep.join((os.path.dirname(source), ".")),
        "-f", os.fspath(paths.lua / "reader.lua"),
        "-L", os.fspath(paths.lua / "filter.lua"),
        "-t", os.fspath(paths.lua / "writer.lua"),
        "-o", os.fspath(staged_html),
    ]

    try:
        completed = subprocess.run(
            command,
            env=environment,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            check=False,
        )
        diagnostics = completed.stderr
        dependencies = _read_dependencies(manifest)
        _atomic_text_write(diagnostics_path, diagnostics)
        if completed.returncode != 0:
            return BuildResult(False, completed.returncode, diagnostics, dependencies)
        if not staged_html.is_file():
            diagnostics += "pandoc did not produce the expected HTML output\n"
            _atomic_text_write(diagnostics_path, diagnostics)
            return BuildResult(False, 1, diagnostics, dependencies)
        try:
            _publish_build(paths, slug, staged_html, staged_media)
        except OSError as error:
            diagnostics += "could not publish preview: {}\n".format(error)
            _atomic_text_write(diagnostics_path, diagnostics)
            return BuildResult(False, 1, diagnostics, dependencies)
        return BuildResult(True, 0, diagnostics, dependencies)
    except FileNotFoundError:
        diagnostics = "pandoc not found. Install it with Homebrew: brew install pandoc\n"
        _atomic_text_write(diagnostics_path, diagnostics)
        return BuildResult(False, 127, diagnostics, set())
    finally:
        shutil.rmtree(stage, ignore_errors=True)


class LiveReloadHub:
    def __init__(self):
        self.clients = set()
        self.lock = threading.Lock()

    def register(self, client):
        with self.lock:
            self.clients.add(client)

    def unregister(self, client):
        with self.lock:
            self.clients.discard(client)

    def broadcast_reload(self, path):
        message = json.dumps({
            "command": "reload",
            "path": path,
            "originalPath": "",
            "liveCSS": True,
            "liveImg": True,
        }, separators=(",", ":"))
        with self.lock:
            clients = list(self.clients)
        delivered = 0
        for client in clients:
            if client.send_text(message):
                delivered += 1
            else:
                self.unregister(client)
                client.close()
        print(
            "LiveReload: broadcasting {} to {} client(s)".format(path, delivered),
            file=sys.stderr,
            flush=True,
        )
        return delivered


class LiveReloadClient:
    def __init__(self, handler):
        self.socket = handler.connection
        self.send_lock = threading.Lock()
        self.open = True

    def read_exact(self, size):
        chunks = []
        while size:
            try:
                chunk = self.socket.recv(size)
            except OSError:
                return None
            if not chunk:
                return None
            chunks.append(chunk)
            size -= len(chunk)
        return b"".join(chunks)

    def read_frame(self):
        header = self.read_exact(2)
        if header is None:
            return None
        first, second = header
        opcode = first & 0x0F
        masked = bool(second & 0x80)
        length = second & 0x7F
        if length == 126:
            raw = self.read_exact(2)
            if raw is None:
                return None
            length = struct.unpack("!H", raw)[0]
        elif length == 127:
            raw = self.read_exact(8)
            if raw is None:
                return None
            length = struct.unpack("!Q", raw)[0]
        mask = self.read_exact(4) if masked else b""
        if mask is None:
            return None
        payload = self.read_exact(length)
        if payload is None:
            return None
        if masked:
            payload = bytes(value ^ mask[index % 4] for index, value in enumerate(payload))
        return opcode, payload

    def read_loop(self):
        while self.open:
            frame = self.read_frame()
            if frame is None:
                break
            opcode, payload = frame
            if opcode == 0x8:
                break
            if opcode == 0x9:
                self.send_frame(0xA, payload)
                continue
            if opcode != 0x1:
                continue
            try:
                message = json.loads(payload.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                continue
            if message.get("command") == "hello":
                self.send_text(json.dumps({
                    "command": "hello",
                    "protocols": [LIVE_RELOAD_PROTOCOL],
                    "serverName": "pandocmd",
                }, separators=(",", ":")))

    def send_text(self, text):
        return self.send_frame(0x1, text.encode("utf-8"))

    def send_frame(self, opcode, payload):
        with self.send_lock:
            if not self.open:
                return False
            frame = bytearray([0x80 | opcode])
            length = len(payload)
            if length < 126:
                frame.append(length)
            elif length < 65536:
                frame.extend(struct.pack("!BH", 126, length))
            else:
                frame.extend(struct.pack("!BQ", 127, length))
            frame.extend(payload)
            try:
                self.socket.sendall(frame)
            except OSError:
                self.open = False
                return False
        return True

    def close(self):
        self.open = False
        with contextlib.suppress(OSError):
            self.socket.shutdown(socket.SHUT_RDWR)
        with contextlib.suppress(OSError):
            self.socket.close()


class LiveReloadHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "pandocmd-preview"

    @property
    def hub(self):
        return self.server.hub

    def log_message(self, format_string, *args):
        print("{} - {}".format(self.address_string(), format_string % args), file=sys.stderr)

    def _path(self):
        return urllib.parse.urlparse(self.path).path

    def _send_json(self, status, payload):
        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_HEAD(self):
        if self._path() == "/__pandocmd/live-reload/health":
            self._send_json(200, {"service": SERVICE_NAME, "pid": os.getpid()})
        else:
            self.send_error(404)

    def do_GET(self):
        path = self._path()
        if path == "/__pandocmd/live-reload/health":
            self._send_json(200, {"service": SERVICE_NAME, "pid": os.getpid()})
        elif path in (LIVE_RELOAD_PATH, "/livereload"):
            self._handle_websocket()
        else:
            self.send_error(404)

    def do_POST(self):
        if self._path() != "/__pandocmd/live-reload":
            self.send_error(404)
            return
        try:
            length = min(int(self.headers.get("Content-Length", "0") or "0"), 4096)
        except ValueError:
            self.send_error(400, "Invalid content length")
            return
        body = self.rfile.read(length)
        path = PREVIEW_URL_PREFIX + "/reload.html"
        if body:
            try:
                payload = json.loads(body.decode("utf-8"))
                path = str(payload.get("path") or path)
            except (UnicodeDecodeError, json.JSONDecodeError):
                self.send_error(400, "Invalid JSON")
                return
        self._send_json(200, {"clients": self.hub.broadcast_reload(path)})

    def _origin_allowed(self):
        origin = self.headers.get("Origin")
        if not origin:
            return True
        origin_host = (urllib.parse.urlparse(origin).hostname or "").lower()
        request_host = (
            urllib.parse.urlparse("//" + self.headers.get("Host", "")).hostname or ""
        ).lower()
        return origin_host == request_host

    def _handle_websocket(self):
        key = self.headers.get("Sec-WebSocket-Key", "")
        if (
            self.headers.get("Upgrade", "").lower() != "websocket"
            or "upgrade" not in self.headers.get("Connection", "").lower()
            or not key
        ):
            self.send_error(400, "Expected a WebSocket upgrade")
            return
        if not self._origin_allowed():
            self.send_error(403)
            return
        accept = base64.b64encode(
            hashlib.sha1((key + WEBSOCKET_MAGIC).encode("ascii")).digest()
        ).decode("ascii")
        self.send_response(101, "Switching Protocols")
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        self.close_connection = True
        client = LiveReloadClient(self)
        self.hub.register(client)
        try:
            client.read_loop()
        finally:
            self.hub.unregister(client)
            client.close()


class LiveReloadServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, address, handler, hub):
        self.hub = hub
        super().__init__(address, handler)

    def handle_error(self, request, client_address):
        error = sys.exception() if hasattr(sys, "exception") else sys.exc_info()[1]
        if isinstance(error, (BrokenPipeError, ConnectionResetError)):
            return
        super().handle_error(request, client_address)


def _read_pid(path):
    try:
        value = path.read_text(encoding="ascii").strip()
        pid = int(value)
        return pid if pid > 1 else None
    except (FileNotFoundError, OSError, UnicodeError, ValueError):
        return None


def _pid_running(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:
        state = subprocess.run(
            ["ps", "-p", str(pid), "-o", "stat="],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=1,
        ).stdout.strip()
        if state.startswith("Z"):
            return False
    except (OSError, subprocess.TimeoutExpired):
        pass
    return True


def _process_command(pid):
    if not _pid_running(pid):
        return ""
    try:
        completed = subprocess.run(
            ["ps", "-p", str(pid), "-o", "command="],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=1,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return completed.stdout.strip()


def _is_pandocmd_process(pid, legacy=False):
    command = _process_command(pid)
    if not command:
        return False
    if legacy:
        return "pandocmd-preview-server.py" in command
    return "pandocmd-preview" in command and "--_daemon" in command


def _find_legacy_daemon_pid():
    marker = "pandocmd-preview-server.py"
    pid_marker = "pandocmd-livereload-{}.pid".format(HUB_PORT)
    try:
        completed = subprocess.run(
            ["ps", "-x", "-o", "pid=,command="],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=1,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in completed.stdout.splitlines():
        fields = line.strip().split(None, 1)
        if len(fields) != 2 or marker not in fields[1]:
            continue
        try:
            pid = int(fields[0])
        except ValueError:
            continue
        command = fields[1]
        if pid_marker in command or str(HUB_PORT) in command.split():
            return pid if _pid_running(pid) else None
    return None


def daemon_health(timeout=0.75):
    request = urllib.request.Request(
        "http://127.0.0.1:{}/__pandocmd/live-reload/health".format(HUB_PORT),
        headers={"Accept": "application/json"},
    )
    try:
        with _urlopen(request, timeout=timeout) as response:
            if response.status != 200:
                return None
            payload = json.loads(response.read(4096).decode("utf-8"))
    except (OSError, urllib.error.URLError, UnicodeError, json.JSONDecodeError):
        return None
    if payload.get("service") != SERVICE_NAME or not isinstance(payload.get("pid"), int):
        return None
    return payload


def daemon_is_healthy(paths):
    recorded = _read_pid(paths.pid_file)
    health = daemon_health()
    return bool(
        recorded
        and health
        and health.get("pid") == recorded
        and _pid_running(recorded)
    )


def _wait_for_exit(pid, timeout=2.0):
    deadline = time.monotonic() + timeout
    while _pid_running(pid) and time.monotonic() < deadline:
        time.sleep(0.05)
    return not _pid_running(pid)


def cleanup_legacy_daemon(temp_dir=None):
    # The Fish implementation used the literal /tmp path even on macOS, where
    # tempfile.gettempdir() normally follows TMPDIR into /var/folders.
    scan_processes = temp_dir is None
    temp_dir = Path(temp_dir) if temp_dir is not None else Path("/tmp")
    pid_file = temp_dir / "pandocmd-livereload-{}.pid".format(HUB_PORT)
    log_file = temp_dir / "pandocmd-livereload-{}.log".format(HUB_PORT)
    pid = _read_pid(pid_file)
    if scan_processes and (not pid or not _pid_running(pid)):
        pid = _find_legacy_daemon_pid()
    if pid and _pid_running(pid):
        if not _is_pandocmd_process(pid, legacy=True):
            return False
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGTERM)
        if not _wait_for_exit(pid):
            return False
    for path in (pid_file, log_file):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
    return True


def _terminate_recorded_daemon(paths, quiet=False):
    pid = _read_pid(paths.pid_file)
    if not pid or not _pid_running(pid):
        with contextlib.suppress(FileNotFoundError):
            paths.pid_file.unlink()
        if not quiet:
            print("Live reload: no daemon is running", file=sys.stderr)
        return True
    health = daemon_health()
    identity_matches = (
        (health and health.get("pid") == pid)
        or _is_pandocmd_process(pid)
    )
    if not identity_matches:
        raise PreviewError(
            "refusing to stop pid {} because it is not the pandocmd preview daemon".format(pid)
        )
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
    if not _wait_for_exit(pid):
        raise PreviewError("live-reload daemon pid {} did not stop".format(pid))
    with contextlib.suppress(FileNotFoundError):
        paths.pid_file.unlink()
    if not quiet:
        print("Live reload: stopped daemon pid {}".format(pid), file=sys.stderr)
    return True


def run_daemon(paths):
    ensure_runtime_state(paths)
    hub = LiveReloadHub()
    try:
        server = LiveReloadServer(("127.0.0.1", HUB_PORT), LiveReloadHandler, hub)
    except OSError as error:
        print("pandocmd daemon: cannot bind 127.0.0.1:{}: {}".format(HUB_PORT, error), file=sys.stderr)
        return 1

    # The launcher already starts this process in a new session. Fork once more
    # after binding so the launcher can be reaped immediately while the server
    # is adopted independently and persists after the watching CLI exits.
    if os.fork() > 0:
        server.server_close()
        os._exit(0)

    _atomic_text_write(paths.pid_file, "{}\n".format(os.getpid()))
    stopping = threading.Event()

    def stop(signum, frame):
        stopping.set()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    server.timeout = 0.5
    try:
        while not stopping.is_set():
            server.handle_request()
    finally:
        server.server_close()
        if _read_pid(paths.pid_file) == os.getpid():
            with contextlib.suppress(FileNotFoundError):
                paths.pid_file.unlink()
    return 0


def ensure_daemon(paths):
    ensure_runtime_state(paths)
    if not cleanup_legacy_daemon():
        raise PreviewError("legacy /tmp daemon pid belongs to another process; stop it manually")
    if daemon_is_healthy(paths):
        return "ready (pid {})".format(_read_pid(paths.pid_file))

    recorded = _read_pid(paths.pid_file)
    if recorded and _pid_running(recorded):
        if _is_pandocmd_process(recorded):
            _terminate_recorded_daemon(paths, quiet=True)
        else:
            raise PreviewError("state/server.pid refers to an unrelated process")
    else:
        with contextlib.suppress(FileNotFoundError):
            paths.pid_file.unlink()

    health = daemon_health()
    if health:
        pid = health["pid"]
        if _is_pandocmd_process(pid):
            _atomic_text_write(paths.pid_file, "{}\n".format(pid))
            return "ready (pid {})".format(pid)
        raise PreviewError("port {} is occupied by an unrecorded live-reload daemon".format(HUB_PORT))

    log = paths.log_file.open("a", encoding="utf-8", buffering=1)
    try:
        launcher = subprocess.Popen(
            [
                sys.executable,
                os.fspath(paths.executable),
                "--_daemon",
                "--_hub-port",
                str(HUB_PORT),
            ],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            cwd=os.fspath(paths.root),
            start_new_session=True,
            close_fds=True,
        )
    finally:
        log.close()

    try:
        launcher_status = launcher.wait(timeout=2.0)
    except subprocess.TimeoutExpired:
        launcher.terminate()
        launcher.wait(timeout=1.0)
        raise PreviewError("live-reload daemon launcher did not detach")
    if launcher_status != 0:
        raise PreviewError("could not start live-reload daemon; see {}".format(paths.log_file))

    deadline = time.monotonic() + 4.0
    while time.monotonic() < deadline:
        if daemon_is_healthy(paths):
            return "started (pid {})".format(_read_pid(paths.pid_file))
        time.sleep(0.05)
    raise PreviewError("live-reload daemon did not become ready; see {}".format(paths.log_file))


def notify_live_reload(slug):
    body = json.dumps({"path": PREVIEW_URL_PREFIX + "/" + slug + ".html"}).encode("utf-8")
    request = urllib.request.Request(
        "http://127.0.0.1:{}/__pandocmd/live-reload".format(HUB_PORT),
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with _urlopen(request, timeout=1.0) as response:
            payload = json.loads(response.read(4096).decode("utf-8"))
            return int(payload.get("clients", 0))
    except (OSError, urllib.error.URLError, UnicodeError, ValueError, json.JSONDecodeError):
        return None


def runtime_watch_files(paths):
    files = set(paths.lua.glob("*.lua"))
    files.update((paths.assets / "templates").glob("*.html"))
    files.update((paths.assets / "css").glob("*.css"))
    files.update(paths.assets.glob("*.tex"))
    files.update(paths.assets.glob("*.csl"))
    return {canonical_path(path) for path in files if path.is_file()}


def _file_signature(path):
    try:
        stat = os.stat(path)
        return (stat.st_mtime_ns, stat.st_size, stat.st_ino)
    except OSError:
        return None


class PollingWatcher:
    def __init__(self, paths):
        self.paths = set(paths)
        self.signatures = {path: _file_signature(path) for path in self.paths}

    def replace_paths(self, paths):
        paths = set(paths)
        self.paths = paths
        self.signatures = {path: _file_signature(path) for path in paths}

    def changed(self):
        changed = False
        for path in self.paths:
            signature = _file_signature(path)
            if signature != self.signatures.get(path):
                changed = True
            self.signatures[path] = signature
        return changed


class DashboardTerminal:
    def __init__(self):
        self.tty = None
        self.saved = None
        self.active = False

    def __enter__(self):
        if not sys.stdout.isatty():
            return self
        try:
            self.tty = open("/dev/tty", "rb", buffering=0)
            self.saved = termios.tcgetattr(self.tty.fileno())
            tty.setcbreak(self.tty.fileno())
        except (OSError, termios.error):
            if self.tty:
                self.tty.close()
            self.tty = None
            self.saved = None
            return self
        self.active = True
        sys.stdout.write("\033[?1049h")
        sys.stdout.flush()
        return self

    def requested_exit(self):
        if not self.tty:
            return False
        readable, _, _ = select.select([self.tty], [], [], 0)
        if not readable:
            return False
        return self.tty.read(1) == b"\x04"

    def __exit__(self, exc_type, exc_value, traceback):
        if self.saved is not None and self.tty is not None:
            with contextlib.suppress(termios.error):
                termios.tcsetattr(self.tty.fileno(), termios.TCSADRAIN, self.saved)
        if self.tty:
            self.tty.close()
        if self.active:
            sys.stdout.write("\033[?1049l")
            sys.stdout.flush()


def render_dashboard(source, url, live_reload, result, clear=False):
    if clear:
        sys.stdout.write("\033[2J\033[H")
    status = "succeeded" if result.succeeded else "failed"
    print("pandocmd preview\n")
    print("  {:<12} {}".format("Source", os.path.basename(source)))
    print("  {:<12} {}".format("URL", url))
    print("  {:<12} {}".format("Live reload", live_reload))
    print("  {:<12} {}".format("Last compile", status))
    print("\nPandoc diagnostics")
    if result.diagnostics.strip():
        for line in result.diagnostics.rstrip().splitlines():
            print("  " + line)
    else:
        print("  None")
    sys.stdout.flush()


def nginx_route_ok(url, timeout=1.5):
    request = urllib.request.Request(url, headers={"Cache-Control": "no-cache"})
    try:
        with _urlopen(request, timeout=timeout) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError):
        return False


def watch_preview(paths, source, slug, url, initial_result):
    live_reload = ensure_daemon(paths)
    if not nginx_route_ok(url):
        live_reload += "; nginx preview route unavailable"
    base_dependencies = {canonical_path(source)} | runtime_watch_files(paths)
    dependencies = base_dependencies | initial_result.dependencies
    watcher = PollingWatcher(dependencies)

    with DashboardTerminal() as terminal:
        render_dashboard(source, url, live_reload, initial_result, clear=terminal.active)
        pending_since = None
        while True:
            if terminal.requested_exit():
                return 0
            if watcher.changed():
                pending_since = time.monotonic()
            if pending_since is not None and time.monotonic() - pending_since >= DEBOUNCE_SECONDS:
                before_build = dict(watcher.signatures)
                result = build_preview(paths, source, slug)
                new_dependencies = base_dependencies | result.dependencies
                changed_during_build = any(
                    path in before_build and _file_signature(path) != before_build[path]
                    for path in new_dependencies
                )
                watcher.replace_paths(new_dependencies)
                if result.succeeded:
                    clients = notify_live_reload(slug)
                    if clients is None:
                        live_reload = "notification failed; daemon may be down"
                    elif clients == 0:
                        live_reload = "ready; no browser connected"
                    else:
                        live_reload = "reloaded {} browser client(s)".format(clients)
                else:
                    live_reload = "not notified because the compile failed"
                render_dashboard(source, url, live_reload, result, clear=terminal.active)
                pending_since = time.monotonic() if changed_during_build else None
            time.sleep(POLL_INTERVAL)


def _doctor_line(label, message):
    print("{:<5} {}".format(label, message))


def run_doctor(paths, public_port):
    failures = 0
    print("pandocmd-preview doctor\n")
    problems = runtime_problems(paths)
    if problems:
        for problem in problems:
            _doctor_line("FAIL", problem)
            failures += 1
    else:
        _doctor_line("OK", "installed runtime layout")
        if os.access(paths.executable, os.X_OK):
            _doctor_line("OK", "preview command is executable")
        else:
            _doctor_line("FAIL", "preview command is not executable: {}".format(paths.executable))
            failures += 1

    for directory in (paths.html, paths.state):
        if directory.is_dir() and os.access(directory, os.W_OK | os.X_OK):
            _doctor_line("OK", "{} is writable".format(directory))
        else:
            _doctor_line("FAIL", "{} is not writable".format(directory))
            failures += 1

    pandoc = shutil.which("pandoc")
    if pandoc:
        try:
            version = subprocess.run(
                [pandoc, "--version"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
                timeout=2,
            )
        except (OSError, subprocess.TimeoutExpired):
            version = None
        if version and version.returncode == 0:
            first_line = version.stdout.splitlines()[0] if version.stdout else pandoc
            _doctor_line("OK", "{} ({})".format(first_line, pandoc))
        else:
            _doctor_line("FAIL", "pandoc could not be executed: {}".format(pandoc))
            failures += 1
    else:
        _doctor_line("FAIL", "pandoc was not found on PATH")
        failures += 1

    pid = _read_pid(paths.pid_file)
    health = daemon_health()
    if daemon_is_healthy(paths):
        _doctor_line("OK", "live-reload daemon is healthy (pid {})".format(pid))
    elif pid or health:
        _doctor_line("FAIL", "live-reload daemon identity or health check failed")
        failures += 1
    else:
        _doctor_line("WARN", "live-reload daemon is not running")

    legacy_pid_file = Path("/tmp") / "pandocmd-livereload-{}.pid".format(HUB_PORT)
    legacy_pid = _read_pid(legacy_pid_file) or _find_legacy_daemon_pid()
    if legacy_pid and _pid_running(legacy_pid):
        if _is_pandocmd_process(legacy_pid, legacy=True):
            _doctor_line(
                "WARN",
                "legacy /tmp daemon is still running (pid {}); the next live preview will replace it".format(
                    legacy_pid
                ),
            )
        else:
            _doctor_line("FAIL", "legacy pid file refers to an unrelated process")
            failures += 1

    authority = "127.0.0.1" if public_port == 80 else "127.0.0.1:{}".format(public_port)
    asset_url = "http://{}/pandocmd-preview/assets/css/default.css".format(authority)
    if nginx_route_ok(asset_url):
        _doctor_line("OK", "nginx asset route: {}".format(asset_url))
    else:
        _doctor_line("FAIL", "nginx asset route unavailable: {}".format(asset_url))
        failures += 1

    previews = (
        sorted(path for path in paths.html.glob("*.html") if not path.name.startswith("."))
        if paths.html.is_dir()
        else []
    )
    if previews:
        route = preview_url(previews[0].stem, public_port)
        if nginx_route_ok(route):
            _doctor_line("OK", "nginx preview route: {}".format(route))
        else:
            _doctor_line("FAIL", "nginx preview route unavailable: {}".format(route))
            failures += 1
    else:
        _doctor_line("WARN", "no generated preview is available for route testing")
    return 1 if failures else 0


def _git_managed_files(source_root):
    try:
        completed = subprocess.run(
            [
                "git", "-C", os.fspath(source_root), "ls-files", "-z", "--",
                "assets", "lua", "bin/pandocmd-preview", "nginx/pandocmd.conf.example",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return set()
    if completed.returncode != 0:
        return set()
    return {
        Path(item.decode("utf-8"))
        for item in completed.stdout.split(b"\0")
        if item
    }


def managed_runtime_files(source_root):
    source_root = Path(source_root)
    candidates = _git_managed_files(source_root)
    # These files can be present in a working tree before they are added to the
    # index. Keeping the explicit additions makes development installs complete
    # without opening the installer to arbitrary untracked files.
    candidates.update({
        Path("bin/pandocmd-preview"),
        Path("nginx/pandocmd.conf.example"),
    })
    candidates.update(Path("lua") / name for name in RUNTIME_LUA_FILES)
    selected = set()
    for relative in candidates:
        parts = relative.parts
        if not parts:
            continue
        if parts[0] == "assets":
            if len(parts) < 2 or parts[1] == "preview" or any(part.startswith(".") for part in parts[1:]):
                continue
        elif parts[0] == "lua":
            if relative.suffix != ".lua":
                continue
        elif relative != Path("bin/pandocmd-preview") and relative != Path("nginx/pandocmd.conf.example"):
            continue
        source = source_root / relative
        if source.is_file():
            selected.add(relative)
    return sorted(selected)


def _replace_managed_directory(staged, destination, name):
    incoming = staged / name
    target = destination / name
    backup = staged / (".old-" + name)
    had_target = target.exists() or target.is_symlink()
    if had_target:
        os.replace(target, backup)
    try:
        os.replace(incoming, target)
    except BaseException:
        if had_target:
            os.replace(backup, target)
        raise
    if backup.is_dir() and not backup.is_symlink():
        shutil.rmtree(backup)
    else:
        with contextlib.suppress(FileNotFoundError):
            backup.unlink()


def _symlink_target(path):
    if not path.is_symlink():
        return None
    return canonical_path(path.parent / os.readlink(path))


def _remove_legacy_links(source_root, installed_root, bin_dir, user_home):
    allowed_commands = {
        canonical_path(source_root / "bin" / "pandocmd-preview"),
        canonical_path(installed_root / "bin" / "pandocmd-preview"),
    }
    legacy_command = bin_dir / "ppl"
    if _symlink_target(legacy_command) in allowed_commands:
        try:
            legacy_command.unlink()
        except OSError as error:
            print("warning: could not remove legacy link {}: {}".format(legacy_command, error), file=sys.stderr)

    if installed_root != user_home / ".pandocmd-preview":
        return
    allowed_completions = {
        canonical_path(source_root / "completions" / "ppl.fish"),
        canonical_path(installed_root / "completions" / "ppl.fish"),
    }
    legacy_completion = user_home / ".config" / "fish" / "completions" / "ppl.fish"
    if _symlink_target(legacy_completion) in allowed_completions:
        try:
            legacy_completion.unlink()
        except OSError as error:
            print("warning: could not remove legacy link {}: {}".format(legacy_completion, error), file=sys.stderr)


def install_runtime(source_root, destination, bin_dir, user_home=None):
    source_root = Path(source_root).expanduser().resolve()
    destination = Path(destination).expanduser().resolve()
    bin_dir = Path(bin_dir).expanduser().resolve()
    user_home = Path(user_home or os.environ.get("HOME") or Path.home()).expanduser().resolve()
    if destination == Path(destination.anchor) or destination == source_root or destination in source_root.parents:
        raise PreviewError("refusing unsafe runtime destination: {}".format(destination))
    if bin_dir == Path(bin_dir.anchor):
        raise PreviewError("refusing unsafe command directory: {}".format(bin_dir))
    files = managed_runtime_files(source_root)
    required = {
        Path("bin/pandocmd-preview"),
        Path("nginx/pandocmd.conf.example"),
        Path("assets/templates/default.html"),
    }
    required.update(Path("lua") / name for name in RUNTIME_LUA_FILES)
    missing = required - set(files)
    if missing:
        raise PreviewError("runtime source is incomplete: {}".format(", ".join(map(str, sorted(missing)))))

    destination.parent.mkdir(parents=True, exist_ok=True)
    staged = Path(tempfile.mkdtemp(prefix=".pandocmd-install-", dir=destination.parent))
    try:
        for name in ("assets", "bin", "lua", "nginx"):
            (staged / name).mkdir()
        for relative in files:
            target = staged / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source_root / relative, target)
        (staged / "bin" / "pandocmd-preview").chmod(0o755)

        destination.mkdir(parents=True, exist_ok=True)
        ensure_runtime_state(runtime_paths(destination))
        for name in ("assets", "bin", "lua", "nginx"):
            _replace_managed_directory(staged, destination, name)
    finally:
        shutil.rmtree(staged, ignore_errors=True)

    bin_dir.mkdir(parents=True, exist_ok=True)
    command_link = bin_dir / "pandocmd-preview"
    desired_target = destination / "bin" / "pandocmd-preview"
    if command_link.exists() or command_link.is_symlink():
        if not command_link.is_symlink():
            raise PreviewError("refusing to replace non-symlink command: {}".format(command_link))
        current_target = _symlink_target(command_link)
        allowed_targets = {
            canonical_path(source_root / "bin" / "pandocmd-preview"),
            canonical_path(desired_target),
        }
        if current_target not in allowed_targets:
            raise PreviewError("refusing to replace unrelated symlink: {}".format(command_link))
        command_link.unlink()
    temporary_link = bin_dir / (".pandocmd-preview.{}.tmp".format(os.getpid()))
    with contextlib.suppress(FileNotFoundError):
        temporary_link.unlink()
    temporary_link.symlink_to(desired_target)
    os.replace(temporary_link, command_link)
    _remove_legacy_links(source_root, destination, bin_dir, user_home)
    return destination


def _remove_path(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        with contextlib.suppress(FileNotFoundError):
            path.unlink()


def purge_previews(destination):
    paths = runtime_paths(destination)
    if paths.root == Path(paths.root.anchor):
        raise PreviewError("refusing to purge a filesystem root")
    if paths.html.is_dir():
        for child in paths.html.iterdir():
            _remove_path(child)
    if paths.diagnostics.is_dir():
        for child in paths.diagnostics.iterdir():
            _remove_path(child)
    if paths.tmp.is_dir():
        for child in paths.tmp.iterdir():
            _remove_path(child)
    for mapping in paths.state.glob("previews.json*") if paths.state.is_dir() else ():
        _remove_path(mapping)


def create_parser():
    parser = argparse.ArgumentParser(
        prog="pandocmd-preview",
        description="Build and preview one Markdown file with the pandocmd Lua pipeline.",
    )
    parser.add_argument("source", nargs="?", metavar="FILE.md")
    parser.add_argument("--build-only", action="store_true", help="build once and exit")
    parser.add_argument("--hash-only", action="store_true", help="print the compatible path hash and exit")
    parser.add_argument("--stop", action="store_true", help="stop the persistent live-reload daemon and exit")
    parser.add_argument("--doctor", action="store_true", help="check the runtime, daemon, Pandoc, and nginx routes")
    parser.add_argument("-p", "--port", type=validate_port, default=DEFAULT_PUBLIC_PORT,
                        help="public nginx port used in the printed URL (default: 80)")
    parser.add_argument("--_daemon", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--_hub-port", type=validate_port, help=argparse.SUPPRESS)
    parser.add_argument("--_install", nargs=3, metavar=("SOURCE", "DESTINATION", "BIN_DIR"),
                        help=argparse.SUPPRESS)
    parser.add_argument("--_purge", metavar="DESTINATION", help=argparse.SUPPRESS)
    return parser


def main(argv=None):
    global HUB_PORT
    parser = create_parser()
    args = parser.parse_args(argv)
    if args._hub_port is not None:
        HUB_PORT = args._hub_port
    paths = runtime_paths()
    try:
        if args._install:
            source, destination, bin_dir = args._install
            installed = install_runtime(source, destination, bin_dir)
            print("Installed pandocmd-preview in {}".format(installed))
            print("Linked {}/pandocmd-preview".format(Path(bin_dir).expanduser()))
            return 0
        if args._purge:
            purge_previews(args._purge)
            print("Purged generated previews from {}".format(Path(args._purge).expanduser()))
            return 0
        if args._daemon:
            return run_daemon(paths)

        if args.stop:
            if args.source or args.build_only or args.hash_only or args.doctor:
                parser.error("--stop cannot be combined with a source or build mode")
            if not cleanup_legacy_daemon():
                raise PreviewError("refusing to stop an unidentified legacy /tmp daemon")
            ensure_runtime_state(paths)
            _terminate_recorded_daemon(paths)
            return 0
        if args.doctor:
            if args.source or args.build_only or args.hash_only:
                parser.error("--doctor cannot be combined with a source or build mode")
            ensure_runtime_state(paths)
            return run_doctor(paths, args.port)
        if not args.source:
            parser.error("FILE.md is required")

        source = canonical_path(args.source)
        if not os.path.isfile(source):
            raise PreviewError("source file does not exist: {}".format(source))
        if args.hash_only:
            if args.build_only:
                parser.error("--hash-only cannot be combined with --build-only")
            print(compatibility_hash(source))
            return 0

        problems = runtime_problems(paths)
        if problems:
            raise PreviewError(problems[0])
        ensure_runtime_state(paths)
        slug = allocate_preview_slug(source, paths.state)
        url = preview_url(slug, args.port)
        result = build_preview(paths, source, slug)
        if args.build_only:
            render_dashboard(source, url, "disabled in build-only mode", result)
            return result.returncode
        if not result.succeeded:
            render_dashboard(source, url, "not started because the compile failed", result)
            return result.returncode
        return watch_preview(paths, source, slug, url, result)
    except PreviewError as error:
        print("error: {}".format(error), file=sys.stderr)
        return 1
    except OSError as error:
        print("error: {}".format(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
